{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env",
    "**/.env.*",
    "eslint.config.mjs",
    ".prettierrc.mjs"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".medusa/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DB_NAME",
        "REDIS_URL",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "STOREFRONT_URL",
        "REVALIDATE_SECRET",
        "PREVIEW_SECRET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "S3_FILE_URL",
        "MEILISEARCH_HOST",
        "MEILISEARCH_API_KEY",
        "MEILISEARCH_SEARCH_KEY",
        "STRIPE_API_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "ALMA_API_KEY",
        "ALMA_MERCHANT_ID",
        "ALMA_MODE",
        "CHRONOFRESH_API_URL",
        "CHRONOFRESH_ACCOUNT",
        "CHRONOFRESH_PASSWORD",
        "COLISSIMO_API_URL",
        "COLISSIMO_ACCOUNT",
        "COLISSIMO_PASSWORD",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "BREVO_API_KEY",
        "BREVO_LIST_ID",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "MEDUSA_BACKEND_URL",
        "NEXT_PUBLIC_MEDUSA_BACKEND_URL",
        "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_DEFAULT_REGION",
        "NEXT_PUBLIC_STRIPE_KEY",
        "NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID",
        "NEXT_PUBLIC_MEILISEARCH_HOST",
        "NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "MEDUSA_CLOUD_S3_HOSTNAME",
        "MEDUSA_CLOUD_S3_PATHNAME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": []
    },
    "typecheck": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
