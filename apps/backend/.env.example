# ──────────────────────────────────────────────────────────────────────
# Lehena — backend (Medusa v2) environment template
# ──────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.
# Variables grouped by phase of the refonte plan (cf. docs/refonte/00-PLAN.md).
# Anything outside Phase 0 is a forward declaration — branchement effectif
# arrive dans la phase indiquée.
# ──────────────────────────────────────────────────────────────────────

# ─── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (Phase 0 — Postgres 16 via docker-compose.dev.yml) ──────
# Format: postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://medusa:medusa@localhost:5432/lehena_dev
DB_NAME=lehena_dev

# ─── Cache / Event bus / Workflow engine (Phase 0 — Redis 7) ──────────
REDIS_URL=redis://localhost:6379

# ─── HTTP CORS (Phase 0) ──────────────────────────────────────────────
# Comma-separated origins. Match storefront + admin dev URLs.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# ─── Auth secrets (Phase 0 — REQUIRED, no fallback) ───────────────────
# Generate via `openssl rand -base64 64`. Never reuse across environments.
JWT_SECRET=
COOKIE_SECRET=

# ─── Storefront integration (Phase 0 — CMS Pages ISR revalidation) ────
STOREFRONT_URL=http://localhost:8000
# Sent by the backend Pages subscriber in the `x-revalidate-secret` header
# when calling the storefront's `/api/revalidate` route. Must match storefront.
REVALIDATE_SECRET=
# Signs JWTs used by the admin "Voir le site" button for draft previews.
# Must match storefront's PREVIEW_SECRET.
PREVIEW_SECRET=

# ─── File storage (Phase 0 — MinIO local / Scaleway S3 prod) ──────────
# In dev, MinIO is reachable at http://localhost:9100. In prod, Scaleway
# Object Storage endpoint (e.g. https://s3.fr-par.scw.cloud).
S3_ENDPOINT=http://localhost:9100
S3_REGION=fr-par
S3_BUCKET=lehena-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for MinIO (and harmless for Scaleway): forces path-style URLs.
S3_FORCE_PATH_STYLE=true
# Public URL prefix used to construct file URLs returned to clients.
# Dev: http://localhost:9100/lehena-media   Prod: https://lehena-media.s3.fr-par.scw.cloud
S3_FILE_URL=http://localhost:9100/lehena-media

# ─── Search (Phase 3 — MeiliSearch via @rokmohar/medusa-plugin-meilisearch) ──
MEILISEARCH_HOST=http://localhost:7700
# Master key set on the MeiliSearch instance. Generate via
# `openssl rand -base64 32` and inject via docker-compose.
MEILISEARCH_API_KEY=
# Search-only key (scoped, read-only) exposed to the storefront. Generated
# from the master key via MeiliSearch's `/keys` endpoint.
MEILISEARCH_SEARCH_KEY=

# ─── Payment — Stripe (Phase 5 — @medusajs/payment-stripe) ────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Payment — Alma (V1: infrastructure préparée mais non activée) ────
# cf. ADR-003. Variables conservées pour l'activation post-V1 (custom
# provider OU hosted-link). Pas branchées dans le checkout Phase 5.
ALMA_API_KEY=
ALMA_MERCHANT_ID=
ALMA_MODE=test

# ─── Fulfillment — Chronofresh (V1: tranches manuelles, pas d'API) ────
# cf. ADR-003. La stratégie V1 reproduit la configuration WooCommerce
# actuelle : prix par tranches de poids, sans appel API temps réel. Les
# variables ci-dessous restent déclarées pour l'intégration V2 si on
# automatise tracking + étiquettes. Inutilisées en V1.
CHRONOFRESH_API_URL=
CHRONOFRESH_ACCOUNT=
CHRONOFRESH_PASSWORD=

# ─── Fulfillment — Colissimo (Phase 5 — custom provider) ──────────────
# Dry goods shipping (La Poste).
COLISSIMO_API_URL=https://ws.colissimo.fr
COLISSIMO_ACCOUNT=
COLISSIMO_PASSWORD=

# ─── Notification — Resend (Phase 7 — custom notification provider) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@lehena.fr

# ─── Marketing — Brevo (Phase 7 — customer sync) ──────────────────────
BREVO_API_KEY=
BREVO_LIST_ID=

# ─── Monitoring — Sentry (Phase 12) ───────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── medusa-ai-assistant plugin (out-of-scope refonte — WIP) ──────────
# Plugin is loaded via yalc on the local machine; see ADR-001. The Anthropic
# API key itself is set through the admin UI (Settings → Assistant IA) and
# stored encrypted in the database using ENCRYPTION_KEY below (AES-256-GCM).
# Rotating ENCRYPTION_KEY invalidates the stored key — operator must re-enter it.
# Opt-in: set ENABLE_AI_ASSISTANT=true to load the plugin. Default off.
ENABLE_AI_ASSISTANT=false
ENCRYPTION_KEY=
ASSISTANT_DEFAULT_MODEL=claude-sonnet-4-6
ASSISTANT_MAX_TOKENS=4096

# ─── WP → Medusa migration (Phase 14 cutover) ────────────────────────
# Consumed by src/migration/readers/woocommerce-api.ts when running
# `medusa exec ./src/scripts/migrate-*.ts -- --source=api`. Generate the
# REST keys in WP-admin → WooCommerce → Settings → Advanced → REST API.
# Read-only is enough; the migration only fetches.
#
# Opt-in: set ENABLE_MIGRATION_MODULE=true to register the migration module
# (admin routes, runs table, recover-stuck cron, etc.). Default off — the
# migration has already been run and the module's auto-generated migration
# is known to be destructive (cf. incident 2026-05-13). Enable only to
# re-run a partial migration or audit historical runs.
ENABLE_MIGRATION_MODULE=false
WC_API_URL=
WC_API_CONSUMER_KEY=
WC_API_CONSUMER_SECRET=
