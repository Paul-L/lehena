{
  "name": "@lehena/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Backend Medusa de Lehena",
  "license": "UNLICENSED",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "meili:reindex": "medusa exec ./src/scripts/meili-reindex.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@hookform/resolvers": "3.4.2",
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/js-sdk": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@rokmohar/medusa-plugin-meilisearch": "^1.3.8",
    "@tanstack/react-query": "5.64.2",
    "@tiptap/extension-character-count": "^3.23.1",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-typography": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "date-fns": "3.6.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "^1.14.0",
    "medusa-ai-assistant": "file:.yalc/medusa-ai-assistant",
    "react-hook-form": "7.49.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.14.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.11",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
