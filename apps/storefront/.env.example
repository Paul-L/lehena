# ──────────────────────────────────────────────────────────────────────
# Lehena — storefront (Next.js 15) environment template
# ──────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# NEXT_PUBLIC_* values are inlined at build time and shipped to the browser —
# only put public, non-secret values there.
# ──────────────────────────────────────────────────────────────────────

# ─── Medusa backend (Phase 0 — REQUIRED) ──────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Publishable key for store-API requests, scoped to a Sales Channel.
# Create via `medusa user --invite` then admin UI Settings > Publishable Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Default region when the country can't be resolved from middleware.
# ISO-2 lowercase. France first.
NEXT_PUBLIC_DEFAULT_REGION=fr

# ─── CMS Pages ISR revalidation (Phase 0 — must match backend) ────────
# Backend's Pages subscriber sends this in `x-revalidate-secret` when calling
# the storefront's `/api/revalidate` route. Same value as backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Used by the admin "Voir le site" button (mints JWT signed with this secret,
# appended as `?preview=<token>`). Same value as backend's PREVIEW_SECRET.
PREVIEW_SECRET=

# ─── Search (Phase 3 — MeiliSearch client) ────────────────────────────
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
# Search-only scoped key (NEVER ship the master key).
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# ─── Payment — Stripe (Phase 5) ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Payments (Cloud) — only set if using Medusa Cloud's payments offer.
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# ─── Image CDN allowlist (Phase 0 + Phase 8 migration) ────────────────
# For Medusa Cloud's hosted S3: hostname + pathname allowed in next.config
# `images.remotePatterns`. Leave empty if using self-hosted Scaleway S3.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# ─── Analytics — Plausible (Phase 12) ─────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Monitoring — Sentry (Phase 12) ───────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Server-only token for uploading sourcemaps at build time.
SENTRY_AUTH_TOKEN=
